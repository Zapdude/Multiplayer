# Assemblies are staged by the Client project's CopyToRimworld target on every
# build. They are build output and are never committed.
/Assemblies/
/AssembliesCustom/

# Packaging and tooling output.
Multiplayer*.zip
/output/

# Local build inputs. PersonalDefinitions.targets is machine-local and required
# for personal builds; never commit it.
PersonalDefinitions.targets
/Source/Publicise-1.0.0.zip
/Source/publicise_hash.txt
/Source/Publicise.exe
/Source/LICENSE
/Source/dnlib.dll
/Source/mpdb

# Verify writes received files when a snapshot changes. The suite rewrites two
# unstable packet fixtures on every run; those are never committed either.
*.received.*
TestResults/
*.binlog

# Build and editor state.
[Bb]in/
[Oo]bj/
.vs/
.idea/
*.user
*.suo

# Python tooling (Languages/update_l10n_tags.py).
__pycache__/
*.pyc

# Local analysis output (graphify writes into graphify-out/ by default).
graphify-out/
