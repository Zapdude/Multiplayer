<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldRefVersion>1.7.4985-unstable</RimWorldRefVersion>
    <MultiplayerHarmonyVersion>3.0.0-rc.3</MultiplayerHarmonyVersion>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/bin/**;**/obj/**</DefaultItemExcludesInProjectFolder>
    <!-- Fail restore/build on known-vulnerable NuGet packages instead of only warning. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
