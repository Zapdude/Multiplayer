<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
        <PackageReference Include="NUnit" Version="4.4.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />

        <PackageReference Include="Lib.Harmony" Version="$(MultiplayerHarmonyVersion)" />

        <PackageReference Include="Verify.NUnit" Version="21.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\Client\Patches\TimestampMath.cs" Link="Client\TimestampMath.cs" />
      <Compile Include="..\Client\Settings\DesyncTracingMode.cs" Link="Client\DesyncTracingMode.cs" />
      <Compile Include="..\Client\Factions\FactionRepeat.cs" Link="Client\FactionRepeat.cs" />
      <Compile Include="..\Client\Networking\ModConfigs.cs" Link="Client\ModConfigs.cs" />
      <Compile Include="..\Client\Desyncs\PatchInventoryFormat.cs" Link="Client\PatchInventoryFormat.cs" />
      <Compile Include="..\Client\Networking\State\DownloadMeter.cs" Link="Client\DownloadMeter.cs" />
      <Compile Include="..\Client\Desyncs\DesyncTraceCapture.cs" Link="Client\DesyncTraceCapture.cs" />
      <Compile Include="..\Client\Util\DeterministicHash.cs" Link="Client\DeterministicHash.cs" />
      <Compile Include="..\Client\Util\HashCodeTranspiler.cs" Link="Client\HashCodeTranspiler.cs" />
      <Compile Include="..\Client\Patches\ViewedMapTracker.cs" Link="Client\ViewedMapTracker.cs" />
      <ProjectReference Include="..\ChatCommandContracts\ChatCommandContracts.csproj" />
      <!-- Common targets net10 on this branch through Directory.Build.props, so this reference
           does not cross a target framework. The 1.6 branch is the one that references net48. -->
      <ProjectReference Include="..\Common\Common.csproj" />
      <ProjectReference Include="..\SourceGen\SourceGen.csproj" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>
